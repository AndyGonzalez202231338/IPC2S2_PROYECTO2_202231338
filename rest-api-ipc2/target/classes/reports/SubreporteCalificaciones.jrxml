<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="SubreporteCalificaciones" 
              pageWidth="535" 
              pageHeight="100" 
              columnWidth="535" 
              leftMargin="0" 
              rightMargin="0" 
              topMargin="0" 
              bottomMargin="0">

    <field name="nombreUsuario" class="java.lang.String"/>
    <field name="calificacion" class="java.lang.Integer"/>
    <field name="fechaCalificacion" class="java.time.LocalDateTime"/>

    <detail>
        <band height="18" splitType="Stretch">
            <!-- Fondo alternado para mejor lectura -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="18" backcolor="#F8F9F9">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            
            <!-- Nombre del usuario -->
            <textField isStretchWithOverflow="true">
                <reportElement x="5" y="1" width="260" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombreUsuario}]]></textFieldExpression>
            </textField>
            
            <!-- Calificación con estrellas visuales -->
            <textField>
                <reportElement x="270" y="1" width="80" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{calificacion} + "/5"]]></textFieldExpression>
            </textField>
            
            <!-- Fecha de calificación -->
            <textField pattern="dd/MM/yyyy">
                <reportElement x="355" y="1" width="175" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fechaCalificacion}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
