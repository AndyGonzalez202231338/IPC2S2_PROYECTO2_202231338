<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="SubreporteUsuarios" pageWidth="555" pageHeight="792" 
              columnWidth="475" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    
    <field name="nombreUsuario" class="java.lang.String"/>
    <field name="cantidadBoletos" class="java.lang.Integer"/>
    
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="350" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[NOMBRE USUARIO]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="0" width="125" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[BOLETOS COMPRADOS]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="19" width="475" height="1"/>
            </line>
        </band>
    </columnHeader>
    
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="350" height="20"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombreUsuario}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="0" width="125" height="20"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cantidadBoletos}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
