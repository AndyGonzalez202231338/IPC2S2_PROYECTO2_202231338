<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="SubreportePeliculas" 
              pageWidth="555" 
              pageHeight="20" 
              columnWidth="555" 
              leftMargin="0" 
              rightMargin="0" 
              topMargin="0" 
              bottomMargin="0">

    <field name="tituloPelicula" class="java.lang.String"/>
    <field name="fechaHoraFuncion" class="java.time.LocalDateTime"/>

    <detail>
        <band height="20" splitType="Stretch">
            <!-- Fondo alternado -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#F8F9F9">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            
            <!-- Título de la película -->
            <textField isStretchWithOverflow="true">
                <reportElement x="10" y="2" width="300" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tituloPelicula}]]></textFieldExpression>
            </textField>
            
            <!-- Fecha y hora -->
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="320" y="2" width="225" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fechaHoraFuncion}]]></textFieldExpression>
            </textField>
            
            <line>
                <reportElement x="0" y="19" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.2" lineColor="#DDDDDD"/>
                </graphicElement>
            </line>
        </band>
    </detail>
</jasperReport>
