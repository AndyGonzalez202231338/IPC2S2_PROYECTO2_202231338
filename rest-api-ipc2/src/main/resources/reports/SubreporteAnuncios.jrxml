<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="SubreporteAnuncios" 
              pageWidth="535" 
              pageHeight="100" 
              columnWidth="535" 
              leftMargin="0" 
              rightMargin="0" 
              topMargin="0" 
              bottomMargin="0">

    <field name="titulo" class="java.lang.String"/>
    <field name="fechaInicio" class="java.time.LocalDateTime"/>
    <field name="fechaFin" class="java.time.LocalDateTime"/>
    <field name="costoTotal" class="java.lang.Double"/>
    <field name="estado" class="java.lang.String"/>

    <detail>
        <band height="20" splitType="Stretch">
            <!-- Fondo alternado para mejor lectura -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="20" backcolor="#F8F9F9">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            
            <!-- Título del anuncio -->
            <textField isStretchWithOverflow="true">
                <reportElement x="5" y="2" width="210" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{titulo}]]></textFieldExpression>
            </textField>
            
            <!-- Fecha inicio -->
            <textField pattern="dd/MM/yyyy">
                <reportElement x="220" y="2" width="75" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fechaInicio}]]></textFieldExpression>
            </textField>
            
            <!-- Fecha fin -->
            <textField pattern="dd/MM/yyyy">
                <reportElement x="300" y="2" width="75" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fechaFin}]]></textFieldExpression>
            </textField>
            
            <!-- Costo -->
            <textField>
                <reportElement x="380" y="2" width="80" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Q " + java.text.NumberFormat.getNumberInstance(java.util.Locale.US).format($F{costoTotal})]]></textFieldExpression>
            </textField>
            
            <!-- Estado -->
            <textField>
                <reportElement x="465" y="2" width="65" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
